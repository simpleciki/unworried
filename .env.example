# Copy to .env and fill in. Never commit .env. Secrets come only from the environment.

# --- Nebius Token Factory ---------------------------------------------------------------------
# Only src/spend/guard.ts reads the key. Create the key in the Token Factory console.
NEBIUS_API_KEY=replace-me

# Not hardcoded anywhere: the application refuses to start a call without it. Value from the official
# Token Factory quickstart (docs.tokenfactory.nebius.com/quickstart, read 2026-10-26):
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# The model id exactly as Token Factory lists it (an NVIDIA Nemotron id). No default exists in code;
# absent → every call is refused with "NEBIUS_MODEL not set". The id must also have a price in
# config/prices.json. The live demo uses nvidia/nemotron-3-super-120b-a12b (since 2026-10-27: Lightning wrote
# duplicate JSON keys in 6 of 12 intake replies, Super in 0). Confirm ids against GET {NEBIUS_BASE_URL}/models.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- The screen (npm start) --------------------------------------------------------------------
# Judge accounts, name:secret pairs. Without this every route but /login answers 401; there is no anonymous mode.
JUDGE_ACCOUNTS=judge1:replace-me,judge2:replace-me
# Bind address and port. Without HOST the server listens on 127.0.0.1 only.
# HOST=0.0.0.0
PORT=8787
# The demo clock ("now" on the screen); ISO 8601 with offset.
DEMO_CLOCK=2026-11-03T09:00:00-06:00

# --- Spending wall -----------------------------------------------------------------------------
# Kill switch. false → every model call is off and callers fall back to recorded samples.
LLM_ENABLED=true

# Append-only JSONL ledger. Must exist before calls are allowed (never starts from zero when missing):
#   npx tsx scripts/spend-status.ts init
SPEND_LEDGER_PATH=state/spend-ledger.jsonl

# Prices in USD per 1M tokens. Default: config/prices.json (read from the Token Factory console, 2026-10-27). To override:
# NEBIUS_PRICES_JSON={"<model id>":{"input_per_m":0.06,"output_per_m":0.24}}

# Limits (defaults shown; change only here, never in code). Money in USD.
SPEND_TOTAL_USD=47          # whole hackathon: balance $50 − $3 margin
SPEND_DAY_USD=3             # per America/Chicago calendar day
SPEND_SESSION_USD=0.15      # per session id (one judge's login)
SPEND_ACTION_USD=0.03       # per action id (one user request), worst case
SPEND_ACTION_CALLS=8        # calls per action id
SPEND_HOUR_USD=0.50         # hourly circuit breaker on actual spend; trips off for the process
SPEND_RATE_GLOBAL=12        # calls per minute, all sessions
SPEND_RATE_SESSION=4        # calls per minute, one session
# max_tokens per call kind, hard cap 1024 (default 512 for any kind not listed):
# SPEND_MAX_TOKENS_EXPLAIN=512

# --- Ledger mirror (only on a host whose disk does not survive a restart) ------------------------
# A private GitHub repository holding one copy of the spend ledger; see docs/spend-wall.md "Ledger mirror".
# The token must be fine-grained, limited to that one repository, Contents: read and write — nothing else.
# Both unset → no mirror (local disk only). One set without the other → model calls stay off, loudly.
# LEDGER_MIRROR_REPO=owner/name
# LEDGER_MIRROR_TOKEN=
# LEDGER_MIRROR_PATH=spend-ledger.jsonl
# LEDGER_MIRROR_BRANCH=main
